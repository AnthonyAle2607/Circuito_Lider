# Variables de DESARROLLO. Copia este archivo a .env (pnpm iniciar lo hace solo si falta).
# Servidor Windows sin Docker: docs/servidor-windows.md.

# «nativos» = Postgres y Redis corren como servicios de Windows; SPOTS_DIR permite guardar archivos en disco local.
# PAUTAS_SERVICIOS=nativos
# En el servidor de producción el .env vive solo allí, con permisos mínimos; nunca en git ni en el vault.

# Base de datos (infra/docker-compose.yml publica Postgres en 127.0.0.1:5433)
# La API usa el rol app_api: sin privilegios y sujeto a la RLS. pnpm iniciar le asigna la clave de esta URL.
DATABASE_URL=postgres://app_api:app_api_dev@127.0.0.1:5433/pautas
# Trabajos en segundo plano: rol app_worker (sin privilegios). pnpm iniciar le asigna la clave de esta URL.
DATABASE_URL_WORKER=postgres://app_worker:app_worker_dev@127.0.0.1:5433/pautas
# Dueño de las tablas: aplica migraciones y da de alta al equipo. Nunca lo usa la API.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@127.0.0.1:5433/pautas

# Colas y límites
REDIS_URL=redis://127.0.0.1:6380

# Almacén local opcional para Windows Server. Si se configura, tiene prioridad sobre S3.
# Usa una ruta absoluta y haz copias de seguridad de esta carpeta.
# SPOTS_DIR=C:/datos/pautas/archivos

# Almacén S3 local para desarrollo (MinIO)
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=pautas
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-dev-only

# Servidor principal
API_PORT=4100
API_HOST=127.0.0.1
# Desde dónde el portal y el panel llaman a la API
API_URL=http://127.0.0.1:4100
# Base de los enlaces que recibe el cliente por correo (verificación de cuenta)
PORTAL_URL=http://localhost:3100
# Detrás de Caddy y del túnel (producción) va en 1 para leer la IP real del cliente
TRUST_PROXY=0

# Llave de 32 bytes (base64) que cifra los secretos del doble factor del equipo.
# ESTA es solo de desarrollo. En producción se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_KEY=ZGVzYXJyb2xsby1zb2xvLWxsYXZlLWRlLTMyLWJ5dGU=

# Solo desarrollo: el enlace de verificación se escribe en el registro de la API (todavía no hay correo).
AVISOS_EN_CONSOLA=1

# Transcripción de spots (PT-6): whisper.cpp local. Sin estas dos, todo spot pasa a revisión humana.
# ffmpeg para spots, huellas y grabación (si no está en el PATH).
# FFMPEG_BIN=C:/herramientas/ffmpeg/bin/ffmpeg.exe
# WHISPER_BIN=C:/herramientas/whisper/whisper-cli.exe
# WHISPER_MODEL=C:/herramientas/whisper/ggml-small.bin

# Grabación de emisoras y certificados (PT-7). El grabador corre aparte: pnpm grabar.
# GRABACIONES_DIR=grabaciones          # carpeta de los bloques (relativa a la raíz o absoluta)
# GRABACION_SEGUNDOS=3600              # largo de cada bloque
# RETENCION_DIAS=30                    # el audio completo se borra a los 30 días; los certificados nunca
# GRABAR_EMISORAS=                     # slugs separados por coma; vacío = todas

# ── Pagos (PT-5) ─────────────────────────────────────────────────────────────
# Por ahora solo «prueba»: una pasarela que no cobra (página alojada en la API, avisos firmados) y que no arranca
# con NODE_ENV=production. Cuando Invermedia elija proveedor, aquí van sus claves.
PAGOS_PROVEEDOR=prueba
# Secreto con que la pasarela de prueba firma sus avisos (32+ caracteres). Genera uno: openssl rand -hex 32
PAGOS_PRUEBA_SECRETO=
# Dirección pública de la API (la página de pago de prueba vive en ella).
API_URL_PUBLICA=http://localhost:4100

# ── Agente vendedor (PT-5b) ──────────────────────────────────────────────────
# Clave de la API de Claude. Sin ella el agente queda apagado y Toño responde con sus respuestas fijas.
# Topes de gasto en config/agente.yaml.
ANTHROPIC_API_KEY=

# ── Avisos (outbox → n8n) ────────────────────────────────────────────────────
# Webhook de n8n que recibe cada evento (correo de verificación, pedido pagado, traspaso a ventas…) y manda el aviso.
# Sin URL, los eventos esperan en el outbox. Contrato y lista de eventos: docs/avisos.md.
AVISOS_URL=
# Secreto con que se firman las entregas (32+ caracteres). n8n verifica la firma: openssl rand -hex 32
AVISOS_SECRETO=
