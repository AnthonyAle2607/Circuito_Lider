# Variables de DESARROLLO. Copia este archivo a .env (pnpm iniciar lo hace solo si falta).
# En el servidor de producción el .env vive solo allí, con permisos mínimos; nunca en git ni en el vault.

# Base de datos (infra/docker-compose.yml publica Postgres en 127.0.0.1:5433)
# La API usa el rol app_api: sin privilegios y sujeto a la RLS. pnpm iniciar le pone esta clave en desarrollo.
DATABASE_URL=postgres://app_api:app_api_dev@127.0.0.1:5433/pautas
# Trabajos en segundo plano: rol app_worker (sin privilegios). pnpm iniciar le pone esta clave en desarrollo.
DATABASE_URL_WORKER=postgres://app_worker:app_worker_dev@127.0.0.1:5433/pautas
# Dueño de las tablas: aplica migraciones y da de alta al equipo. Nunca lo usa la API.
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@127.0.0.1:5433/pautas

# Colas y límites
REDIS_URL=redis://127.0.0.1:6380

# Almacén S3 local (MinIO)
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=pautas
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-dev-only

# Servidor principal
API_PORT=4100
API_HOST=127.0.0.1
# Desde dónde el portal y el panel llaman a la API
API_URL=http://127.0.0.1:4100
# Base de los enlaces que recibe el cliente por correo (verificación de cuenta)
PORTAL_URL=http://localhost:3100
# Detrás de Caddy y del túnel (producción) va en 1 para leer la IP real del cliente
TRUST_PROXY=0

# Llave de 32 bytes (base64) que cifra los secretos del doble factor del equipo.
# ESTA es solo de desarrollo. En producción se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_KEY=ZGVzYXJyb2xsby1zb2xvLWxsYXZlLWRlLTMyLWJ5dGU=

# Solo desarrollo: el enlace de verificación se escribe en el registro de la API (todavía no hay correo).
AVISOS_EN_CONSOLA=1

# Transcripción de spots (PT-6): whisper.cpp local. Sin estas dos, todo spot pasa a revisión humana.
# WHISPER_BIN=C:/herramientas/whisper/whisper-cli.exe
# WHISPER_MODEL=C:/herramientas/whisper/ggml-small.bin
