{
  "name": "sistema-de-pautas",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @sp/db migrate",
    "iniciar": "node scripts/iniciar.mjs",
    "cargar-parrilla": "pnpm --filter @sp/catalogo cargar"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
